# Claude Code (machine-local settings)
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Environment — 절대 커밋하지 않는다
.env
.env.*
!.env.example

# OS
.DS_Store

# Simulation outputs
outputs/
results/

# 손으로 파본 흔적 — raw_calls 조각 같은 것. 저장소에 남을 것이 아니다
memo
memo/
scratch/
*.scratch
logs/
# 산출물은 제외하되 **본실험 30판의 핵심 로그는 전부 동봉한다** (8/29 · 심사 대비) —
